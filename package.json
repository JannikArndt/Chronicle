{
  "name": "chronicle",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:server": "node scripts/build-server.mjs --watch",
    "build": "tsc -b && vite build && npm run build:server",
    "build:client": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "node --enable-source-maps --disable-warning=ExperimentalWarning dist-server/main.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "buildid": "node server/buildid.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.17.1",
    "esbuild": "0.25.12",
    "fake-indexeddb": "^6.0.0",
    "playwright-core": "^1.61.1",
    "typescript": "^5.6.3",
    "vite": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
