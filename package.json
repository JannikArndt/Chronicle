{
  "name": "chronicle",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "dev:server": "node scripts/build-server.mjs --watch",
    "build": "tsc -b && vite build && npm run build:server",
    "build:client": "vite build",
    "build:server": "node scripts/build-server.mjs",
    "start": "node --enable-source-maps --disable-warning=ExperimentalWarning dist-server/main.mjs",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "buildid": "node server/buildid.mjs",
    "verify": "node scripts/verify.mjs",
    "live": "node scripts/live.mjs",
    "ship": "node scripts/ship.mjs",
    "logs": "node scripts/logs.mjs"
  },
  "dependencies": {
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.0.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "ajv": "^8.17.1",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.6",
    "playwright-core": "^1.64.1",
    "typescript": "^5.6.3",
    "vite": "^6.4.5",
    "vitest": "^2.1.8"
  }
}
