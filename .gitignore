# Dependencies and build output
node_modules/
dist/
# TypeScript's incremental-build cache: machine-local, and it turned up as a
# modified file in every single commit.
tsconfig.tsbuildinfo

# Editor noise
.DS_Store

# Backend config. .env.example is tracked and holds no values; anything with a
# real key in it is not. The anon key is publishable, but .env files are also
# where a service_role key ends up by accident, and that one bypasses RLS.
.env
.env.*
!.env.example

# Supabase CLI local state: the linked project ref, container volumes, temp files.
supabase/.temp/
supabase/.branches/

# NOTE ON PRIVACY: personal timeline data must NEVER appear in this repo.
# The shipped app keeps it in IndexedDB and user-initiated export files only.
# There is intentionally no local-data/ folder — only public-data/ is repo-tracked.
