{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/JannikArndt/Timeline/public-data/schema.json",
  "title": "Chronicle public dataset",
  "description": "A TimelineDataset restricted to what public data needs: no birth dates or nesting (public data is ownerless). Ids only need to be unique within this file — the app namespaces them on load.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "groups", "rows", "entries"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "groups": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "label", "collapsed"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "website": { "type": "string", "minLength": 1, "description": "A site standing for this group; drawn as its favicon in front of the name." },
          "collapsed": { "type": "boolean" }
        }
      }
    },
    "rows": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "groupId", "label"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "groupId": { "type": "string", "minLength": 1 },
          "color": { "type": "string", "minLength": 1, "description": "Any CSS color for this row's bars; omit for a neutral default." },
          "icon": { "type": "string", "minLength": 1, "description": "One emoji shown before the row label; optional." },
          "website": { "type": "string", "minLength": 1, "description": "A site standing for this timeline; drawn as its favicon in place of the emoji." },
          "label": { "type": "string", "minLength": 1 }
        }
      }
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rowId", "title", "start"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "rowId": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "subtitle": { "type": "string", "minLength": 1 },
          "shortTitle": { "type": "string", "minLength": 1 },
          "website": { "type": "string", "minLength": 1 },
          "place": { "$ref": "#/$defs/place" },
          "description": { "type": "string" },
          "start": { "$ref": "#/$defs/fuzzyDate" },
          "end": { "$ref": "#/$defs/fuzzyDate" },
          "fadeInDays": { "type": "number", "minimum": 0 },
          "fadeOutDays": { "type": "number", "minimum": 0 },
          "parentEntryId": { "type": "string", "minLength": 1 }
        }
      }
    },
    "events": {
      "type": "array",
      "description": "Moments rather than spans — a launch, a first, a landing. Optional: a dataset of pure spans simply omits this. Events are only drawn once the view is zoomed in far enough for a point in time to be readable.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "rowId", "title", "date"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "rowId": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "icon": { "type": "string", "minLength": 1, "description": "One emoji drawn in front of the label; optional." },
          "description": { "type": "string" },
          "place": { "$ref": "#/$defs/place" },
          "date": { "$ref": "#/$defs/fuzzyDate" }
        }
      }
    }
  },
  "$defs": {
    "place": {
      "type": "object",
      "additionalProperties": false,
      "required": ["fullName"],
      "properties": {
        "fullName": { "type": "string", "minLength": 1 },
        "coordinates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["lat", "lon"],
          "properties": {
            "lat": { "type": "number" },
            "lon": { "type": "number" }
          }
        },
        "street": { "type": "string", "minLength": 1 },
        "city": { "type": "string", "minLength": 1 },
        "country": { "type": "string", "minLength": 1 }
      }
    },
    "fuzzyDate": {
      "type": "object",
      "additionalProperties": false,
      "required": ["ms", "precision"],
      "properties": {
        "ms": { "type": "number", "description": "UTC milliseconds since epoch (Date.UTC)" },
        "precision": { "enum": ["exact", "day", "month", "year", "circa"] },
        "fuzzDays": { "type": "number", "minimum": 0 }
      }
    }
  }
}
